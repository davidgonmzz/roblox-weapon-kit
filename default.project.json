{
  "name": "weapon-kit",
  "globIgnorePaths": [
    "**/*.tmp",
    "**/*.tmp.*",
    "**/sed*",
    "**/*~",
    "**/.#*"
  ],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "WeaponKitShared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "WeaponKitServer": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "WeaponKitClient": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$attributes": {
        "WeaponKitDemo": true
      }
    }
  }
}
